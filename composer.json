{
    "name": "ld/desenvolvimento-web",
    "description": "LD Desenvolvimento Web - plataforma gamificada de cursos de programação",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.0",
        "firebase/php-jwt": "^7.1",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Helpers/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
